# Google Cloud Text-to-Speech & Application Default Credentials
# Project ID with Text-to-Speech API enabled:
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Method 1 (Recommended for Deployment / Vercel / Cloud):
GOOGLE_CLIENT_ID=your-oauth2-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth2-client-secret
GOOGLE_REFRESH_TOKEN=your-oauth2-refresh-token

# Method 2: Path to JSON credentials file (Optional, for local environments)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json

# Method 3: Complete JSON credentials as a single string (Optional)
# GOOGLE_CREDENTIALS_JSON={"client_id":"...","client_secret":"...","refresh_token":"...","type":"authorized_user"}
